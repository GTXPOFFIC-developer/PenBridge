<Window x:Class="DashboardHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard Host"
        Height="780" Width="1020"
        MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <Grid Grid.Row="0" Background="{StaticResource SurfaceDark}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                    <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Dashboard Host" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <Border Background="#252A4A" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.1.0" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentViolet}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Android / iOS Tablet → Windows Pen Bridge" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </StackPanel>

            <!-- Right header actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button x:Name="CheckUpdateBtn" Content="⟳ Update" Style="{StaticResource SecondaryButtonStyle}" Click="CheckUpdateBtn_Click" Padding="10,5" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Check for latest updates and auto-update without installer"/>
                <Border x:Name="ServerStatusBadge" Background="#16382C" BorderBrush="{StaticResource StatusGreen}" BorderThickness="1" CornerRadius="14" Padding="10,5" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusLed" Width="7" Height="7" Fill="{StaticResource StatusGreen}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="ServerStatusText" Text="LISTENING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatusGreen}"/>
                    </StackPanel>
                </Border>
                <Button x:Name="ToggleServerBtn" Content="Stop" Style="{StaticResource SecondaryButtonStyle}" Click="ToggleServerBtn_Click" Padding="12,6" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <CheckBox x:Name="StartWithWindowsChk" Content="Auto-start" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="12,0,16,0" Checked="StartWithWindowsChk_Changed" Unchecked="StartWithWindowsChk_Changed" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- Window control buttons (dark theme integrated) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="MinimizeBtn_Click" Style="{StaticResource WindowCtrlBtn}" Content="—" ToolTip="Minimize to Tray"/>
                    <Button Click="MaximizeBtn_Click" Style="{StaticResource WindowCtrlBtn}" Content="◻" ToolTip="Maximize / Restore"/>
                    <Button Click="CloseBtn_Click" Style="{StaticResource WindowCloseBtn}" Content="✕" ToolTip="Close (Hide to Tray)"/>
                </StackPanel>
            </StackPanel>

            <!-- Bottom border -->
            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{StaticResource BorderDark}"/>
        </Grid>

        <!-- ══════════════ MAIN BODY ══════════════ -->
        <Grid Grid.Row="1" Margin="18,16,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANEL ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Google Sign-in Card -->
                <Border Grid.Row="0" Background="{StaticResource CardGlassBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#1E2247" Margin="0,0,10,0">
                                <TextBlock Text="G" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentViolet}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Google Auto-Pair" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="No backend · no relay · same account = trusted" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Signed In -->
                        <Border x:Name="GoogleSignedInPanel" Visibility="Collapsed" Background="#0E1629" BorderBrush="#252F5A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                                    <TextBlock x:Name="GoogleUserInitials" Text="G" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="GoogleUserName" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="GoogleUserEmail" Text="" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Border Background="#16382C" CornerRadius="4" Padding="5,2" Margin="0,0,0,4">
                                        <TextBlock Text="✓ Active" FontSize="9" FontWeight="Bold" Foreground="{StaticResource StatusGreen}"/>
                                    </Border>
                                    <Button Content="Out" Style="{StaticResource SecondaryButtonStyle}" Click="GoogleSignOutBtn_Click" Padding="6,3" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Signed Out -->
                        <StackPanel x:Name="GoogleSignedOutPanel">
                            <Button x:Name="GoogleSignInBtn" Style="{StaticResource PrimaryButtonStyle}" Click="GoogleSignInBtn_Click" HorizontalAlignment="Stretch" Padding="0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="G" FontSize="14" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sign in with Google" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- PIN Pairing Card -->
                <Border Grid.Row="2" Background="{StaticResource CardGlassBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#1E2247" Margin="0,0,10,0">
                                <TextBlock Text="#" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentViolet}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="6-Digit Pairing PIN" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Enter on tablet if not using Google" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#0E1629" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" CornerRadius="8" Padding="0,14" Margin="0,0,0,10">
                            <TextBlock x:Name="PairingCodeText" Text="000 000" FontSize="36" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AccentViolet}" HorizontalAlignment="Center"/>
                        </Border>
                        <Button x:Name="RegenPinBtn" Content="↻  New PIN" Style="{StaticResource SecondaryButtonStyle}" Click="RegenPinBtn_Click" HorizontalAlignment="Stretch" Padding="0,8"/>
                    </StackPanel>
                </Border>

                <!-- USB / ADB Card -->
                <Border Grid.Row="4" Background="{StaticResource CardGlassBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#1E2247" Margin="0,0,10,0">
                                <TextBlock Text="🔌" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="USB Connection" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="LocalIpText" Text="Wi-Fi: detecting IP…" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ADB Status Message -->
                        <Border x:Name="AdbStatusBorder" Visibility="Collapsed" Background="#0E1629" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="AdbStatusTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AdbStatusGuidance" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="AdbReverseBtn" Content="⚡  Setup USB Tunnel (adb reverse)" Style="{StaticResource PrimaryButtonStyle}" Click="AdbReverseBtn_Click" HorizontalAlignment="Stretch" Padding="0,10"/>
                        <TextBlock Text="Bundled adb.exe included · USB Debugging must be enabled" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Splitter gap -->
            <Border Grid.Column="1"/>

            <!-- ── RIGHT PANEL ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Stylus Telemetry Card -->
                <Border Grid.Row="0" Background="{StaticResource CardGlassBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Stylus Telemetry" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Live data from tablet — updates at pen sample rate" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Target:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="DisplayTargetCombo" Width="130" FontSize="11" SelectionChanged="DisplayTargetCombo_SelectionChanged" Background="#12162B" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderGlass}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Stat row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0E1629" CornerRadius="7" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="X · Y" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="CoordsText" Text="0 · 0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#0E1629" CornerRadius="7" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="TILT X · Y" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TiltText" Text="0° · 0°" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="#0E1629" CornerRadius="7" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="PRESSURE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="PressureText" Text="0%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Background="#0E1629" CornerRadius="7" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="STATE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="StateText" Text="IDLE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource StatusAmber}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Pressure bar -->
                        <ProgressBar x:Name="PressureGauge" Height="5" Minimum="0" Maximum="1024" Value="0" Margin="0,10,0,0" BorderThickness="0" Background="#0E1629">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#4F46E5" Offset="1"/>
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                    </StackPanel>
                </Border>

                <!-- Paired Devices Card -->
                <Border Grid.Row="2" Background="{StaticResource CardGlassBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Paired Devices" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text=" — authorized tablets only" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </StackPanel>

                        <ItemsControl x:Name="DevicesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0E1629" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📱" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Ip}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text="{Binding AuthMethod}" FontSize="10" Foreground="{StaticResource AccentViolet}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Revoke" Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding DeviceId}" Click="RevokeDeviceBtn_Click" Padding="7,3" FontSize="10" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoDevicesNotice" Text="No devices paired. Open the Android or iOS app to connect." FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Activity Log Card -->
                <Border Grid.Row="4" Background="{StaticResource CardGlassBrush}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="10" Click="ClearLogBtn_Click"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#0A0C18" CornerRadius="6" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <TextBox x:Name="LogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="#8A95BF" BorderThickness="0" FontFamily="Consolas" FontSize="11" Padding="8" TextWrapping="NoWrap"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════ FOOTER ══════════════ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatusText" Text="Ready — Waiting for Android / iOS tablet connection." FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Dashboard Protocol v1  ·  UDP 41173 / 41174  ·  TCP 41174" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Border>
</Window>
